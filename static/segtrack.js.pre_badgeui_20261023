/* 💰 수익 구간 자동 추적 (/api/segments/track) — 정보 표시 전용, 픽·확률 변경 없음. */
(function () {
  const ST = window.SEGTRACK = {d: null, at: 0};
  const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'}[c]));
  const pct = x => x == null ? '–' : (x * 100 >= 0 ? '+' : '') + (x * 100).toFixed(1) + '%';
  ST.load = async function () {
    if (ST.d && Date.now() - ST.at < 600000) return ST.d;
    try { ST.d = await fetch('/api/segments/track').then(r => r.json()); ST.at = Date.now(); } catch (e) { ST.d = ST.d || {tracks: []}; }
    return ST.d;
  };
  const ob = o => !o ? null : o < 1.70 ? '1.70 미만' : o < 2 ? '1.70–2.0' : o < 2.5 ? '2.0–2.5' : o < 3.5 ? '2.5–3.5' : '3.5+';
  const pb = p => p == null ? null : p < .3 ? '30% 미만' : p < .4 ? '30–40%' : p < .5 ? '40–50%' : '50% 이상';
  const eb = e => e == null ? null : e <= -.1 ? '−10% 이하' : e < -.05 ? '−10~−5%' : e < 0 ? '−5~0%' : '0% 이상';
  const bb = t => { t = String(t || '').replace('전반 ', ''); for (const k of ['핸디캡', '언더/오버', '승①패', '일반', '머니라인']) if (t.startsWith(k)) return k; return t.split(' ')[0]; };
  /* x: {fam, kind, sport, league, bet_type, p, odds} → matching active tracks */
  ST.match = function (x) {
    const d = ST.d; if (!d || !x || !x.odds) return [];
    const f = {sport: x.sport, league: x.league, bet: bb(x.bet_type), odds_band: ob(x.odds), p_band: pb(x.p),
      ev_band: eb(x.p != null ? x.p * x.odds - 1 : null), kind: x.kind};
    f['sport×odds_band'] = f.sport && f.odds_band ? f.sport + '·' + f.odds_band : null;
    return (d.tracks || []).filter(t => (t.status === 'candidate' || t.status === 'validated') && t.fam === x.fam && f[t.dim] === t.value);
  };
  ST.badge = function (x) {
    const ts = ST.match(x); if (!ts.length) return '';
    const v = ts.some(t => t.status === 'validated');
    const tip = ts.map(t => `${t.fam} ${t.dim_ko}=${t.value} (${t.status === 'validated' ? '전진 검증 통과' : '후보'}, 전진 ${t.fwd_n || 0}건 ROI ${pct(t.fwd_roi)})`).join(' / ');
    return `<span class="srcl ${v ? 'src-ok' : 'src-wait'}" title="${esc(tip)} · 정보 표시만, 픽 변경 없음">${v ? '💰 수익 구간' : '🔍 수익 후보'}</span>`;
  };
  ST.cardHtml = function (m) {
    if (!ST.d) return '';
    const r = m && m.recommend || {}, out = [];
    for (const [k, kind] of [['best_prob', 'proto_rec_prob'], ['best_ev', 'proto_rec_ev']]) {
      const b = r[k]; if (!b) continue;
      const h = ST.badge({fam: '일반', kind, sport: m.sport, league: m.league, bet_type: b.bet_type, p: b.p, odds: b.odds});
      if (h && !out.some(o => o.h === h)) out.push({h, t: `${b.bet_type} ${b.label || ''}`});
    }
    const u = m && m.upset_pick;
    if (u && u.status === 'pick' && u.odds) {
      const h = ST.badge({fam: '역배', kind: 'proto_upset_pick', sport: m.sport, league: m.league, bet_type: u.bet_type, p: u.p, odds: u.odds});
      if (h) out.push({h, t: '역배 ' + (u.label || '')});
    }
    return out.length ? `<div class="mc-src">${out.map(o => `${o.h} <span class="muted sm">${esc(o.t)}</span>`).join(' ')}</div>` : '';
  };
  ST.sectionHtml = function (d) {
    if (!d) return '<div class="muted">수익 구간 추적 데이터 없음</div>';
    const lab = {candidate: '🔍 후보 (전진 추적 중)', validated: '💰 검증 통과', dropped: '탈락'};
    const rows = (d.tracks || []).map(t => `<tr><td>${esc(t.fam)} · ${esc(t.dim_ko)}<br><b>${esc(t.value)}</b></td><td>${lab[t.status] || esc(t.status)}</td><td>${esc(t.flagged_day)}</td>
      <td>${t.fwd_n || 0}건 ${t.fwd_hits || 0}적중<br>ROI ${pct(t.fwd_roi)} (하한 ${pct(t.fwd_lo)})</td><td>${t.past && t.past.all ? `${t.past.all.n}건 ROI ${pct(t.past.all.roi)}` : '–'}</td></tr>`).join('');
    const top = (d.top_all || []).slice(0, 6).map(s => `<tr><td>${esc(s.seg.replace(/\|/g, ' · '))}</td><td>${s.n}</td><td>${pct(s.roi)}</td><td>${pct(s.lo)}</td><td>${s.q != null ? s.q.toFixed(2) : '–'}</td></tr>`).join('');
    return `<div class="card"><div class="sub">${esc(d.rules || '')}</div><div class="sub">업데이트 ${esc(d.updated_kst || '–')} KST · 채점 픽 ${d.n_rows || 0}건 · 검정 ${d.n_tested || 0}개</div>
      ${rows ? `<div class="tw"><table class="mt"><thead><tr><th>구간</th><th>상태</th><th>후보 지정</th><th>전진(실전) 성적</th><th>과거 전체</th></tr></thead><tbody>${rows}</tbody></table></div>`
        : '<div class="sub"><b>현재 후보 없음</b> — 기준(n≥50, 신뢰구간 하한>0 또는 q<0.1)을 넘는 구간이 아직 없습니다.</div>'}
      <details><summary>참고: ROI 상위 구간 (n≥50, 전체 기간 — 아직 유의하지 않음)</summary><div class="tw"><table class="mt"><thead><tr><th>구간</th><th>n</th><th>ROI</th><th>95% 하한</th><th>q</th></tr></thead><tbody>${top}</tbody></table></div></details></div>`;
  };
  ST.load().then(() => { try { if (typeof sport !== 'undefined' && sport === 'proto' && typeof protoLoad === 'function') protoLoad(); } catch (e) {} });
  if (typeof module !== 'undefined') module.exports = ST;
})();
